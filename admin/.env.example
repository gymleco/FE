# ══════════════════════════════════════════════════════════
#  gymleco / admin  —  Vite + React
#
#  복사:  cp .env.example .env.local
#  Vite 는 VITE_ 접두사가 붙은 값만 클라이언트에 노출한다.
#  시크릿을 여기에 두지 않는다. 관리자 SPA 는 브라우저에서 도는 코드다.
# ══════════════════════════════════════════════════════════

# API 는 같은 오리진의 /api 로 호출한다.
# 이 값을 절대 URL 로 바꾸면 동일 오리진 구성이 깨지고
# CORS·쿠키 문제가 되살아난다. 로컬 개발에서만 Vite 프록시로 우회한다.
VITE_API_BASE_PATH=/api

# 로컬 개발용 — Vite dev server 가 /api 를 이 주소로 프록시한다.
# 운영 빌드에는 사용되지 않는다.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
