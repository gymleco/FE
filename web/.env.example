# ══════════════════════════════════════════════════════════
#  gymleco / web  —  Next.js 15 (App Router)
#
#  복사:  cp .env.example .env.local
#  .env.local 은 절대 커밋하지 않는다. (.gitignore 에 이미 등록됨)
#  NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 노출된다.
#  시크릿에는 절대 이 접두사를 붙이지 말 것.
# ══════════════════════════════════════════════════════════

# 공개 사이트 URL — 메타태그, OG 이미지, sitemap.xml 의 절대경로에 쓰인다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Spring Boot API 오리진.
#
# ★ 운영에서는 사이트와 "같은 등록가능도메인의 서브도메인"이어야 한다.
#     사이트  www.gymleco.co.kr
#     API     api.gymleco.co.kr     ← same-site 로 취급됨. OK
#
#   다른 도메인(예: *.vercel.app, 별도 도메인)에 두면
#   관리자 인증 쿠키(SameSite=Strict)가 아예 전송되지 않아 로그인이 불가능하다.
#   도메인 구조는 인증 설계의 선행 조건이다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 이미지 CDN 오리진 (CloudFront 배포 주소). 스킴까지 포함한 전체 오리진.
#   예:  https://cdn.gymleco.co.kr
# next.config.ts 가 이 값에서 images.remotePatterns 와 CSP 의 img-src 를 함께 만든다.
NEXT_PUBLIC_CDN_ORIGIN=

# ── CSP ────────────────────────────────────────────────────
# 처음에는 반드시 false 로 두고 Report-Only 로 관찰한다.
# 브라우저 콘솔에 위반이 없는 것을 확인한 뒤 true 로 바꾼다.
# (nonce 방식은 SSG/ISR 을 비활성화시키므로 공개 페이지에는 쓰지 않는다)
CSP_ENFORCE=false

# ── 서버 전용 (브라우저에 노출되지 않음) ────────────────────

# CMS 에서 제품/소식을 발행하면 Spring Boot 가 이 토큰으로
# /api/revalidate 를 호출해 정적 페이지를 갱신한다.
# 이게 없으면 대표님이 제품을 올려도 사이트에 반영되지 않는다.
# api/.env 의 REVALIDATE_TOKEN 과 반드시 같은 값이어야 한다.
#   생성:  openssl rand -hex 32
REVALIDATE_TOKEN=change-me-generate-with-openssl-rand-hex-32
